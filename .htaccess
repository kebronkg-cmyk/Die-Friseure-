# Die Friseure: liegt auf STRATO in /haidhausen, wird über
# .github/workflows/strato.yml mit hochgeladen.

# Immer die sichere Adresse ohne www
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://die-friseure-haidhausen.de%{REQUEST_URI} [R=301,L]

# Kleine Schutzschicht für den Browser
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
